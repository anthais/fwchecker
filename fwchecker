#!/bin/bash
#
# Firewall Checker Tool v2.0
# Check firewall connectivity with host-based configuration
#

set -o pipefail

# Colors
readonly GREEN='\033[92m'
readonly RED='\033[91m'
readonly YELLOW='\033[93m'
readonly BLUE='\033[94m'
readonly BOLD='\033[1m'
readonly NC='\033[0m' # No Color

# Global variables
CONFIG_FILE=""
OUTPUT_FORMAT="pretty"  # pretty, csv, tsv, table
VERBOSE=false

# Associative arrays for host definitions
declare -A HOST_TYPE
declare -A HOST_IP
declare -A HOST_PORT
declare -A HOST_USER
declare -A HOST_PASS
declare -A HOST_OPEN_PORTS

# Arrays for check commands
declare -A CHECK_COMMANDS  # CHECK_COMMANDS[hostname]="cmd1\ncmd2\ncmd3"
declare -a CHECK_ORDER     # Array to maintain insertion order

# Results storage
declare -a RESULTS
declare -a RESULT_SOURCE
declare -a RESULT_TARGET
declare -a RESULT_METHOD
declare -a RESULT_DETAIL
declare -a RESULT_STATUS

TOTAL_COUNT=0
PASS_COUNT=0
FAIL_COUNT=0

#==============================================================================
# Functions
#==============================================================================

print_usage() {
    cat << EOF
Firewall Checker Tool v2.0 - Check firewall connectivity

Usage: $(basename "$0") --config=<config-file> [OPTIONS]
       $(basename "$0") -c <config-file> [OPTIONS]

Options:
    -c, --config           Path to config file (required)
    -f, --format FORMAT    Output format: pretty, csv, tsv, table (default: pretty)
    -v, --verbose          Enable verbose mode (show detailed debug information)
    -h, --help             Show this help message

Output formats:
    pretty    Colorful output with symbols (default)
    csv       Comma-separated values for Excel
    tsv       Tab-separated values for Excel
    table     Plain text table format

Config file format v2:
    [HOST:name]
    type=local|remote|external
    ip=<ip_or_hostname>
    port=<ssh_port>
    user=<ssh_user>
    password=<ssh_pass>
    openServicePorts=<port1,port2,...>
    
    [CHECK:hostname]
    cmd=ping <target>
    cmd=telnet <target> <port>
    cmd=curl <full_curl_command>
    newline

Examples:
    $(basename "$0") --config=example.conf
    $(basename "$0") -c example.conf --format=csv
    $(basename "$0") -c example.conf -v
EOF
}

parse_args() {
    if [[ $# -eq 0 ]]; then
        print_usage
        exit 1
    fi

    while [[ $# -gt 0 ]]; do
        case $1 in
            -c|--config)
                CONFIG_FILE="$2"
                shift 2
                ;;
            --config=*)
                CONFIG_FILE="${1#*=}"
                shift
                ;;
            -f|--format)
                OUTPUT_FORMAT="$2"
                shift 2
                ;;
            --format=*)
                OUTPUT_FORMAT="${1#*=}"
                shift
                ;;
            -v|--verbose)
                VERBOSE=true
                shift
                ;;
            -h|--help)
                print_usage
                exit 0
                ;;
            *)
                echo -e "${RED}Error: Unknown option: $1${NC}" >&2
                print_usage
                exit 1
                ;;
        esac
    done

    if [[ -z "$CONFIG_FILE" ]]; then
        echo -e "${RED}Error: --config is required${NC}" >&2
        print_usage
        exit 1
    fi
    
    # Validate output format
    if [[ ! "$OUTPUT_FORMAT" =~ ^(pretty|csv|tsv|table)$ ]]; then
        echo -e "${RED}Error: Invalid format '$OUTPUT_FORMAT'. Use: pretty, csv, tsv, or table${NC}" >&2
        exit 1
    fi
}

log_verbose() {
    if [[ "$VERBOSE" == "true" ]]; then
        echo -e "${BLUE}[DEBUG]${NC} $*" >&2
    fi
}

log_verbose_section() {
    if [[ "$VERBOSE" == "true" ]]; then
        echo -e "${BLUE}[DEBUG] --- $* ---${NC}" >&2
    fi
}

parse_config() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        echo -e "${RED}Error: Config file not found: $CONFIG_FILE${NC}" >&2
        return 1
    fi

    log_verbose "Reading config file: $CONFIG_FILE"
    
    local current_section=""
    local current_host=""
    local line_num=0
    local host_count=0
    local check_count=0

    while IFS= read -r line || [[ -n "$line" ]]; do
        ((line_num++))
        
        # Skip comments and empty lines
        [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
        
        # Remove inline comments
        line=$(echo "$line" | sed 's/[[:space:]]*#.*$//')
        
        # Remove leading/trailing whitespace
        line=$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        
        # Check for section headers
        if [[ "$line" =~ ^\[HOST:([^]]+)\]$ ]]; then
            current_section="HOST"
            current_host="${BASH_REMATCH[1]}"
            log_verbose "Found HOST section: $current_host"
            ((host_count++))
            continue
        elif [[ "$line" =~ ^\[CHECK:([^]]+)\]$ ]]; then
            current_section="CHECK"
            current_host="${BASH_REMATCH[1]}"
            log_verbose "Found CHECK section: $current_host"
            ((check_count++))
            CHECK_COMMANDS[$current_host]=""
            CHECK_ORDER+=("$current_host")  # Track insertion order
            continue
        fi
        
        # Parse HOST parameters
        if [[ "$current_section" == "HOST" ]]; then
            if [[ "$line" =~ ^type=(.+)$ ]]; then
                HOST_TYPE[$current_host]="${BASH_REMATCH[1]}"
                log_verbose "  $current_host.type = ${BASH_REMATCH[1]}"
            elif [[ "$line" =~ ^ip=(.+)$ ]]; then
                HOST_IP[$current_host]="${BASH_REMATCH[1]}"
                log_verbose "  $current_host.ip = ${BASH_REMATCH[1]}"
            elif [[ "$line" =~ ^port=(.+)$ ]]; then
                HOST_PORT[$current_host]="${BASH_REMATCH[1]}"
                log_verbose "  $current_host.port = ${BASH_REMATCH[1]}"
            elif [[ "$line" =~ ^user=(.+)$ ]]; then
                HOST_USER[$current_host]="${BASH_REMATCH[1]}"
                log_verbose "  $current_host.user = ${BASH_REMATCH[1]}"
            elif [[ "$line" =~ ^password=(.+)$ ]]; then
                HOST_PASS[$current_host]="${BASH_REMATCH[1]}"
                log_verbose "  $current_host.password = ****"
            elif [[ "$line" =~ ^openServicePorts=(.+)$ ]]; then
                HOST_OPEN_PORTS[$current_host]="${BASH_REMATCH[1]}"
                log_verbose "  $current_host.openServicePorts = ${BASH_REMATCH[1]}"
            fi
        # Parse CHECK commands
        elif [[ "$current_section" == "CHECK" ]]; then
            if [[ "$line" =~ ^cmd=(.+)$ ]]; then
                local cmd="${BASH_REMATCH[1]}"
                if [[ -z "${CHECK_COMMANDS[$current_host]}" ]]; then
                    CHECK_COMMANDS[$current_host]="$cmd"
                else
                    CHECK_COMMANDS[$current_host]="${CHECK_COMMANDS[$current_host]}"$'\n'"$cmd"
                fi
                log_verbose "  Added command: $cmd"
            elif [[ "$line" == "newline" ]]; then
                CHECK_COMMANDS[$current_host]="${CHECK_COMMANDS[$current_host]}"$'\n'"newline"
                log_verbose "  Added newline directive"
            fi
        fi
    done < "$CONFIG_FILE"
    
    if [[ $host_count -eq 0 ]]; then
        echo -e "${RED}Error: No hosts defined in config${NC}" >&2
        return 1
    fi
    
    if [[ $check_count -eq 0 ]]; then
        echo -e "${RED}Error: No checks defined in config${NC}" >&2
        return 1
    fi
    
    if [[ "$OUTPUT_FORMAT" == "pretty" ]]; then
        echo -e "${GREEN}✓ Loaded $host_count host(s) and $check_count check section(s) from config${NC}\n"
    fi
    return 0
}

resolve_host() {
    local name="$1"
    
    # If it's an IP address, return as is
    if [[ "$name" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo "$name"
        return 0
    fi
    
    # Try to resolve from HOST definitions
    if [[ -n "${HOST_IP[$name]}" ]]; then
        echo "${HOST_IP[$name]}"
        return 0
    fi
    
    # Return the name as-is (let DNS resolve it)
    echo "$name"
    return 0
}

ssh_open_port() {
    local hostname="$1"
    local port="$2"
    
    local ip="${HOST_IP[$hostname]}"
    local ssh_port="${HOST_PORT[$hostname]:-22}"
    local ssh_user="${HOST_USER[$hostname]}"
    local ssh_pass="${HOST_PASS[$hostname]}"
    
    log_verbose "Attempting to open port $port on $hostname ($ip)..."
    
    # Build SSH command
    local ssh_cmd=""
    if [[ -n "$ssh_pass" ]]; then
        if ! command -v sshpass &>/dev/null; then
            log_verbose "sshpass not available"
            return 1
        fi
        ssh_cmd="sshpass -p '$ssh_pass' ssh"
    else
        ssh_cmd="ssh"
    fi
    
    # Add SSH options
    ssh_cmd="$ssh_cmd -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=5 -o LogLevel=ERROR"
    
    # Add user and host
    if [[ -n "$ssh_user" ]]; then
        ssh_cmd="$ssh_cmd -p $ssh_port ${ssh_user}@${ip}"
    else
        ssh_cmd="$ssh_cmd -p $ssh_port ${hostname}"
    fi
    
    # Add remote command
    ssh_cmd="$ssh_cmd 'nohup nc -l -p $port >/dev/null 2>&1 &'"
    
    log_verbose "SSH command: $ssh_cmd"
    
    eval "$ssh_cmd" 2>&1
    local result=$?
    
    if [[ $result -eq 0 ]]; then
        log_verbose "Port $port opened successfully"
        sleep 1
        return 0
    else
        log_verbose "Failed to open port $port"
        return 1
    fi
}

exec_command() {
    local source_host="$1"
    local command="$2"
    
    local host_type="${HOST_TYPE[$source_host]}"
    
    if [[ "$host_type" == "local" ]]; then
        # Execute locally
        log_verbose "Executing locally: $command"
        eval "$command"
        return $?
    elif [[ "$host_type" == "remote" ]]; then
        # Execute via SSH
        local ip="${HOST_IP[$source_host]}"
        local ssh_port="${HOST_PORT[$source_host]:-22}"
        local ssh_user="${HOST_USER[$source_host]}"
        local ssh_pass="${HOST_PASS[$source_host]}"
        
        # Build SSH command
        local ssh_cmd=""
        if [[ -n "$ssh_pass" ]]; then
            if ! command -v sshpass &>/dev/null; then
                echo "sshpass not available"
                return 1
            fi
            ssh_cmd="sshpass -p '$ssh_pass' ssh"
        else
            ssh_cmd="ssh"
        fi
        
        # Add SSH options
        ssh_cmd="$ssh_cmd -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=5 -o LogLevel=ERROR"
        
        # Add user and host
        if [[ -n "$ssh_user" ]]; then
            ssh_cmd="$ssh_cmd -p $ssh_port ${ssh_user}@${ip}"
        else
            ssh_cmd="$ssh_cmd -p $ssh_port ${source_host}"
        fi
        
        # Add remote command
        ssh_cmd="$ssh_cmd '$command'"
        
        log_verbose "Executing via SSH: $ssh_cmd"
        
        eval "$ssh_cmd"
        return $?
    else
        echo "Unknown host type: $host_type"
        return 1
    fi
}

check_ping() {
    local source_host="$1"
    local target="$2"
    
    local resolved_target=$(resolve_host "$target")
    log_verbose "Ping check: $source_host -> $target ($resolved_target)"
    
    local cmd="ping -c 3 -W 2 $resolved_target >/dev/null 2>&1"
    exec_command "$source_host" "$cmd"
    local result=$?
    
    if [[ $result -eq 0 ]]; then
        log_verbose "Ping OK"
        return 0
    else
        log_verbose "Ping FAIL"
        return 1
    fi
}

check_telnet() {
    local source_host="$1"
    shift
    local telnet_args="$*"
    
    # Extract target and port from telnet args for openServicePorts check
    read -ra TELNET_PARTS <<< "$telnet_args"
    local target="${TELNET_PARTS[0]}"
    local port="${TELNET_PARTS[1]}"
    
    local resolved_target=$(resolve_host "$target")
    log_verbose "Telnet check: $source_host -> telnet $telnet_args"
    
    # Check if port needs to be opened
    if [[ -n "$port" ]]; then
        local open_ports="${HOST_OPEN_PORTS[$target]}"
        if [[ -n "$open_ports" ]]; then
            IFS=',' read -ra PORTS <<< "$open_ports"
            for p in "${PORTS[@]}"; do
                p=$(echo "$p" | tr -d ' ')
                if [[ "$p" == "$port" ]]; then
                    log_verbose "Port $port is in openServicePorts list, trying to open it"
                    ssh_open_port "$target" "$port"
                    break
                fi
            done
        fi
    fi
    
    # Run telnet command as-is (with resolved hostname)
    local cmd="telnet $resolved_target ${port}"
    local output=$(exec_command "$source_host" "timeout 5 $cmd < /dev/null 2>&1")
    local result=$?
    
    if [[ $result -eq 0 || "$output" == *"Connected"* || "$output" == *"Escape character"* ]]; then
        log_verbose "Telnet OK: $output"
        echo "Connection successful"
        return 0
    else
        log_verbose "Telnet FAIL: $output"
        if echo "$output" | grep -qi "Connection refused"; then
            echo "Connection refused"
        elif echo "$output" | grep -qi "timed out\|timeout"; then
            echo "Connection timeout"
        elif echo "$output" | grep -qi "No route to host"; then
            echo "No route to host"
        elif echo "$output" | grep -qi "Name or service not known"; then
            echo "Cannot resolve hostname"
        else
            echo "Connection failed"
        fi
        return 1
    fi
}

check_curl() {
    local source_host="$1"
    shift
    local curl_args="$*"
    
    log_verbose "Curl check: $source_host -> curl $curl_args"
    
    local cmd="$curl_args"
    local output=$(exec_command "$source_host" "$cmd" 2>&1)
    local result=$?
    
    if [[ $result -eq 0 ]]; then
        log_verbose "Curl OK"
        echo "Success"
        return 0
    else
        log_verbose "Curl FAIL: $output"
        echo "Failed"
        return 1
    fi
}

process_check() {
    local source_host="$1"
    local cmd_line="$2"
    
    log_verbose_section "Processing: $cmd_line"
    
    # Handle newline directive
    if [[ "$cmd_line" == "newline" ]]; then
        if [[ "$OUTPUT_FORMAT" == "pretty" ]]; then
            echo ""
        fi
        return 0
    fi
    
    # Parse command
    read -ra CMD_PARTS <<< "$cmd_line"
    local method="${CMD_PARTS[0]}"
    
    case "$method" in
        ping)
            local target="${CMD_PARTS[1]}"
            ((TOTAL_COUNT++))
            
            if check_ping "$source_host" "$target"; then
                ((PASS_COUNT++))
                RESULT_SOURCE+=("$source_host")
                RESULT_TARGET+=("$target")
                RESULT_METHOD+=("ping")
                RESULT_DETAIL+=("-")
                RESULT_STATUS+=("PASS")
                
                if [[ "$OUTPUT_FORMAT" == "pretty" ]]; then
                    echo -e "  ${GREEN}✓ PING${NC} $source_host -> $target"
                fi
            else
                ((FAIL_COUNT++))
                RESULT_SOURCE+=("$source_host")
                RESULT_TARGET+=("$target")
                RESULT_METHOD+=("ping")
                RESULT_DETAIL+=("Cannot ping")
                RESULT_STATUS+=("FAIL")
                
                if [[ "$OUTPUT_FORMAT" == "pretty" ]]; then
                    echo -e "  ${RED}✗ PING${NC} $source_host -> $target (Cannot ping)"
                fi
            fi
            ;;
            
        telnet)
            shift 1  # Remove 'telnet' from CMD_PARTS
            local telnet_args="${cmd_line#telnet }"
            ((TOTAL_COUNT++))
            
            # Extract target and port for display
            read -ra TELNET_PARTS <<< "$telnet_args"
            local target="${TELNET_PARTS[0]}"
            local port="${TELNET_PARTS[1]}"
            
            local detail=$(check_telnet "$source_host" "$telnet_args")
            local result=$?
            
            if [[ $result -eq 0 ]]; then
                ((PASS_COUNT++))
                RESULT_SOURCE+=("$source_host")
                RESULT_TARGET+=("$target:$port")
                RESULT_METHOD+=("telnet")
                RESULT_DETAIL+=("$detail")
                RESULT_STATUS+=("PASS")
                
                if [[ "$OUTPUT_FORMAT" == "pretty" ]]; then
                    echo -e "  ${GREEN}✓ TELNET${NC} $source_host -> $target:$port"
                fi
            else
                ((FAIL_COUNT++))
                RESULT_SOURCE+=("$source_host")
                RESULT_TARGET+=("$target:$port")
                RESULT_METHOD+=("telnet")
                RESULT_DETAIL+=("$detail")
                RESULT_STATUS+=("FAIL")
                
                if [[ "$OUTPUT_FORMAT" == "pretty" ]]; then
                    echo -e "  ${RED}✗ TELNET${NC} $source_host -> $target:$port ($detail)"
                fi
            fi
            ;;
            
        curl)
            shift 1  # Remove 'curl' from CMD_PARTS
            local curl_args="${cmd_line#curl }"
            ((TOTAL_COUNT++))
            
            local detail=$(check_curl "$source_host" "$curl_args")
            local result=$?
            
            # Extract URL for display
            local url=$(echo "$curl_args" | grep -oP 'https?://[^ ]+' | head -1)
            [[ -z "$url" ]] && url="$curl_args"
            
            if [[ $result -eq 0 ]]; then
                ((PASS_COUNT++))
                RESULT_SOURCE+=("$source_host")
                RESULT_TARGET+=("$url")
                RESULT_METHOD+=("curl")
                RESULT_DETAIL+=("$detail")
                RESULT_STATUS+=("PASS")
                
                if [[ "$OUTPUT_FORMAT" == "pretty" ]]; then
                    echo -e "  ${GREEN}✓ CURL${NC} $source_host -> $url"
                fi
            else
                ((FAIL_COUNT++))
                RESULT_SOURCE+=("$source_host")
                RESULT_TARGET+=("$url")
                RESULT_METHOD+=("curl")
                RESULT_DETAIL+=("$detail")
                RESULT_STATUS+=("FAIL")
                
                if [[ "$OUTPUT_FORMAT" == "pretty" ]]; then
                    echo -e "  ${RED}✗ CURL${NC} $source_host -> $url ($detail)"
                fi
            fi
            ;;
            
        *)
            log_verbose "Unknown command: $method"
            ;;
    esac
}

run_checks() {
    if [[ "$OUTPUT_FORMAT" == "pretty" ]]; then
        echo ""
        echo -e "${BOLD}${BLUE}============================================================${NC}"
        echo -e "${BOLD}${BLUE}  FIREWALL CHECKER - STARTING CHECKS${NC}"
        echo -e "${BOLD}${BLUE}============================================================${NC}"
        echo ""
    fi
    
    # Process checks for each host in order
    for source_host in "${CHECK_ORDER[@]}"; do
        if [[ "$OUTPUT_FORMAT" == "pretty" ]]; then
            echo -e "${BOLD}Checking from: $source_host (${HOST_TYPE[$source_host]})${NC}"
        fi
        
        # Split commands by newline and execute
        while IFS= read -r cmd_line; do
            [[ -z "$cmd_line" ]] && continue
            process_check "$source_host" "$cmd_line"
        done <<< "${CHECK_COMMANDS[$source_host]}"
        
        if [[ "$OUTPUT_FORMAT" == "pretty" ]]; then
            echo ""
        fi
    done
    
    print_summary
}

print_summary() {
    case "$OUTPUT_FORMAT" in
        csv)
            print_csv
            ;;
        tsv)
            print_tsv
            ;;
        table)
            print_table
            ;;
        pretty|*)
            print_pretty
            ;;
    esac
}

print_csv() {
    echo "Source,Target,Method,Detail,Result"
    
    for ((i=0; i<${#RESULT_SOURCE[@]}; i++)); do
        echo "${RESULT_SOURCE[$i]},${RESULT_TARGET[$i]},${RESULT_METHOD[$i]},\"${RESULT_DETAIL[$i]}\",${RESULT_STATUS[$i]}"
    done
}

print_tsv() {
    echo -e "Source\tTarget\tMethod\tDetail\tResult"
    
    for ((i=0; i<${#RESULT_SOURCE[@]}; i++)); do
        echo -e "${RESULT_SOURCE[$i]}\t${RESULT_TARGET[$i]}\t${RESULT_METHOD[$i]}\t${RESULT_DETAIL[$i]}\t${RESULT_STATUS[$i]}"
    done
}

print_table() {
    printf "%-15s %-30s %-10s %-30s %-8s\n" "Source" "Target" "Method" "Detail" "Result"
    printf "%-15s %-30s %-10s %-30s %-8s\n" "---------------" "------------------------------" "----------" "------------------------------" "--------"
    
    for ((i=0; i<${#RESULT_SOURCE[@]}; i++)); do
        printf "%-15s %-30s %-10s %-30s %-8s\n" "${RESULT_SOURCE[$i]}" "${RESULT_TARGET[$i]}" "${RESULT_METHOD[$i]}" "${RESULT_DETAIL[$i]}" "${RESULT_STATUS[$i]}"
    done
    
    echo ""
    echo "Total: $TOTAL_COUNT | Passed: $PASS_COUNT | Failed: $FAIL_COUNT"
}

print_pretty() {
    echo -e "${BOLD}${BLUE}============================================================${NC}"
    echo -e "${BOLD}${BLUE}  SUMMARY${NC}"
    echo -e "${BOLD}${BLUE}============================================================${NC}"
    echo ""
    
    for ((i=0; i<${#RESULT_SOURCE[@]}; i++)); do
        if [[ "${RESULT_STATUS[$i]}" == "PASS" ]]; then
            echo -e "${GREEN}✓ PASS${NC} - ${RESULT_SOURCE[$i]} -> ${RESULT_TARGET[$i]} (${RESULT_METHOD[$i]})"
        else
            echo -e "${RED}✗ FAIL${NC} - ${RESULT_SOURCE[$i]} -> ${RESULT_TARGET[$i]} (${RESULT_METHOD[$i]}: ${RESULT_DETAIL[$i]})"
        fi
    done
    
    echo ""
    echo -e "${BOLD}Total: $TOTAL_COUNT | Passed: ${GREEN}$PASS_COUNT${NC}${BOLD} | Failed: ${RED}$FAIL_COUNT${NC}"
    echo -e "${BOLD}${BLUE}============================================================${NC}"
    echo ""
}

#==============================================================================
# Main
#==============================================================================

main() {
    parse_args "$@"
    
    if ! parse_config; then
        exit 1
    fi
    
    run_checks
    
    # Exit with proper code
    if [[ $FAIL_COUNT -gt 0 ]]; then
        exit 1
    else
        exit 0
    fi
}

# Trap Ctrl+C
trap 'echo -e "\n${YELLOW}Cancelled by user${NC}"; exit 130' INT

main "$@"
