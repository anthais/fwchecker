# Firewall Checker Requirements
# Không cần thư viện Python bổ sung
# Tool sử dụng các module built-in của Python 3

# Yêu cầu hệ thống (cần cài đặt trên OS):
# - ping (thường có sẵn)
# - sshpass (cho SSH với password)
# - netcat/nc (cho việc mở port trên remote machine)
# - ssh client (thường có sẵn)

# Để cài đặt các tool hệ thống trên Ubuntu/Debian:
# sudo apt-get install -y sshpass netcat-openbsd

# Trên RHEL/CentOS:
# sudo yum install -y sshpass nc

